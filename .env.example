# Server
PORT=5000

# Frontend origins. CLIENT_URL is used for CORS and Stripe redirects.
CLIENT_URL=http://localhost:3000
# Optional comma-separated extra origins for production.
CORS_ORIGINS=

# MongoDB. Use the same database as the Next.js Better Auth app.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=fixmate

# Better Auth JWT verification.
# BETTER_AUTH_SECRET stays in the Next.js .env; this server only reads JWKS.
BETTER_AUTH_URL=http://localhost:3000
# Optional override if the API reaches JWKS through a different URL.
# Defaults to <BETTER_AUTH_URL>/api/auth/jwks
BETTER_AUTH_JWKS_URL=
JWT_ISSUER=fixmate
JWT_AUDIENCE=fixmate-client

# Stripe test mode only. Secrets must never reach the browser.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ImgBB server-side upload key.
IMGBB_API_KEY=

# Password for the demo accounts created by `npm run seed`.
SEED_PASSWORD=Demo1234
