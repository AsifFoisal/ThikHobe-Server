PORT=5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=

# Same database as the Next.js Better Auth app.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=fixmate

# Better Auth origin and JWT settings. These must match the Next.js app.
BETTER_AUTH_URL=http://localhost:3000
JWT_ISSUER=fixmate
JWT_AUDIENCE=fixmate-client

# ImgBB key is server-only. Never expose it to the browser.
IMGBB_API_KEY=

# Password used by `npm run seed` for the demo accounts.
SEED_PASSWORD=Demo1234
